# Copy to .env.local and fill in from the Supabase dashboard → Project Settings → API.
# Leave empty to run in local demo mode (browser storage only, nothing is sent to a server).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional. Mapbox public token (starts with pk.) for the Mapbox + OpenStreetMap basemap.
# Without it the maps use plain OpenStreetMap tiles. Get one free at https://account.mapbox.com/
VITE_MAPBOX_TOKEN=
# Optional. Mapbox style id, default mapbox/streets-v12
VITE_MAPBOX_STYLE=
